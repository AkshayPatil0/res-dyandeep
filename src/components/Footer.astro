---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: "/", text: "Home" },
  { href: "/about", text: "About Us" },
  { href: "/cbse-disclosures", text: "CBSE Mandatory Disclosures" },
  { href: "/contact", text: "Contact Us" },
];
---

<footer class="bg-slate-900 text-slate-300 relative border-t border-slate-800">
  <!-- Top Accent Color Bar -->
  <div class="h-1.5 w-full bg-gradient-to-r from-blue-700 via-indigo-600 to-amber-500"></div>

  <div class="container mx-auto px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
      
      <!-- Col 1: School Information & Branding (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-start space-x-3.5">
          <img
            src="/images/logo.png"
            alt="Dyandeep Vidyalaya Logo"
            class="w-14 h-14 object-contain rounded-full bg-white p-1 shadow-md shrink-0"
          />
          <div>
            <span class="block text-xs uppercase tracking-wider font-semibold text-yellow-400">
              Radhanand Education Society's
            </span>
            <h3 class="text-xl font-bold text-white tracking-tight leading-snug">
              Dyandeep Vidyalaya
            </h3>
            <p class="text-xs text-slate-400">
              Mangsuli &bull; Taluka Kagwad &bull; Dist. Belagavi
            </p>
          </div>
        </div>

        <p class="text-sm text-slate-400 leading-relaxed">
          Nurturing young minds with knowledge, holistic skills, and values. Providing a stimulating, supportive environment for complete educational excellence.
        </p>

        <div class="flex flex-wrap gap-2 pt-1 text-xs">
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-slate-800/80 text-slate-300 border border-slate-700">
            <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2"></span>CBSE Curriculum Pattern
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-slate-800/80 text-slate-300 border border-slate-700">
            Co-educational
          </span>
        </div>
      </div>

      <!-- Col 2: Quick Links (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white border-b border-slate-800 pb-2">
          Quick Links
        </h4>
        <ul class="space-y-2.5 text-sm">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-400 hover:text-yellow-400 hover:translate-x-1 inline-flex items-center gap-1.5 transition-all duration-200"
              >
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: School Address & Direction Info (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white border-b border-slate-800 pb-2">
          Campus Address
        </h4>

        <div class="bg-slate-800/50 border border-slate-800 rounded-xl p-4 space-y-3">
          <div class="flex items-start space-x-3">
            <div class="p-2 bg-blue-900/40 border border-blue-700/50 rounded-lg text-blue-400 shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
            </div>
            <div class="text-xs leading-relaxed text-slate-300">
              <p class="font-semibold text-sm text-white mb-0.5">Dyandeep Vidyalaya</p>
              <p>Ainapur Road, Near Bus Stand,</p>
              <p>At Post Mangasuli, Taluka: Kagwad,</p>
              <p>Dist: Belagavi, Karnataka – 591234</p>
            </div>
          </div>

          <!-- Direct Google Maps Link Button -->
          <div class="pt-1">
            <a
              href="https://maps.app.goo.gl/bJq4db8NSZeWBS7r8?g_st=aw"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold shadow-md shadow-blue-950/40 hover:shadow-blue-900/60 transition-all duration-200 transform hover:-translate-y-0.5"
            >
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
              <span>View on Google Maps</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 4: Interactive Map UI (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <h4 class="text-sm font-semibold uppercase tracking-wider text-white">
            Find Us on Map
          </h4>
          <span class="inline-flex items-center gap-1.5 text-[11px] text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Campus Location
          </span>
        </div>

        <!-- Map Card UI -->
        <div class="rounded-xl overflow-hidden border border-slate-700/80 bg-slate-850 shadow-lg group">
          <div class="relative">
            <iframe
              title="Dyandeep Vidyalaya Mangasuli Campus Map"
              src="https://maps.google.com/maps?q=PRHR%2BW5P+Dnyandeep+Vidyalaya+Mangasuli%2C+Karnataka+591234&t=&z=15&ie=UTF8&iwloc=&output=embed"
              class="w-full h-44 border-0 block"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>

          <!-- Map Footer Bar -->
          <div class="p-2.5 bg-slate-950/90 border-t border-slate-800 flex items-center justify-between text-xs">
            <div class="flex items-center gap-1.5 text-slate-400">
              <svg class="w-3.5 h-3.5 text-red-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="truncate">Mangasuli, Karnataka</span>
            </div>
            <a
              href="https://maps.app.goo.gl/bJq4db8NSZeWBS7r8?g_st=aw"
              target="_blank"
              rel="noopener noreferrer"
              class="text-yellow-400 hover:text-yellow-300 font-semibold inline-flex items-center gap-1 shrink-0 ml-2"
            >
              Get Directions
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="border-t border-slate-800/80 mt-12 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400 text-center md:text-left">
      <p>
        &copy; {currentYear} Radhanand Education Society's <strong class="text-slate-300">Dyandeep Vidyalaya, Mangsuli</strong>. All rights reserved.
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-xs">
        <a href="/cbse-disclosures" class="hover:text-yellow-400 transition duration-200">
          CBSE Disclosures
        </a>
        <span class="text-slate-600">&bull;</span>
        <a href="/about" class="hover:text-yellow-400 transition duration-200">
          About Campus
        </a>
        <span class="text-slate-600">&bull;</span>
        <a href="/contact" class="hover:text-yellow-400 transition duration-200">
          Contact
        </a>
      </div>
    </div>
  </div>
</footer>
